    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orra reads mail in the Mail app only for Projects, and only from the mailboxes you choose. The mail it reads stays on this Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra lee el correo en la app Mail solo para Proyectos y solo en los buzones que elijas. El correo que lee no sale de esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは、“プロジェクト”機能のためだけに、選択したメールボックスのメールのみを“メール”アプリから読み取ります。読み取ったメールがこのMacから送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 只为“项目”功能读取“邮件” App 中的邮件，而且只读取你选择的邮箱。它读取的邮件只留在这台 Mac 上。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orra listens to the sound your Mac plays, such as a call, to show live captions and translations. The audio stays on this Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra escucha el sonido que reproduce tu Mac, como una llamada, para mostrar subtítulos y traducciones en vivo. El audio no sale de esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは、ライブキャプションと翻訳を表示するために、通話などMacで再生される音声を聞き取ります。聞き取った音声がこのMacから送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 会收听 Mac 播放的声音（例如通话），以显示实时字幕和翻译。音频只留在这台 Mac 上。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orra records your voice while you hold the talk key and turns it into text on this Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra graba tu voz mientras mantienes presionada la tecla para hablar y la convierte en texto en esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは、音声入力キーを押している間あなたの声を録音し、このMac上でテキストに変換します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 会在你按住说话键时录下你的声音，并在这台 Mac 上把它转成文字。"
          }
        }
      }
    }
  },
  "version" : "1.3"
}
