        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerido a partir de tu correo en Sin proyecto, de donde pasarían %lld correos. Revisa el nombre, las personas y los dominios, y agrega las carpetas del proyecto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト未定”のメールから提案されたプロジェクトです。作成すると、そこから%lld件のメールが移ります。名前、関係者、ドメインを確認し、プロジェクトのフォルダを追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据“待归入项目”中的邮件建议，创建后会从中移入 %lld 封邮件。请检查名称、人员和域名，并添加项目的文件夹。"
          }
        }
      }
