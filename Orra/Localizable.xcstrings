        }
      }
    },
    "The draft may decide something only you can. Compare it with Before you reply." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el borrador decida algo que solo tú puedes decidir. Compáralo con Antes de responder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きが、あなたにしか決められないことを決めている可能性があります。“返信する前に”と照らし合わせてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
