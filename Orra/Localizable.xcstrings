{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (lid closed)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已合盖）"
          }
        }
      }
    },
    "%@ (not connected)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（未连接）"
          }
        }
      }
    },
    "%@ could not start" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动"
          }
        }
      }
    },
    "%@ is chosen under Microphone. Choose another microphone or System Default there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“麦克风”中选择的是 %@。请在那里改选其他麦克风或“系统默认”。"
          }
        }
      }
    },
    "%@ is not connected, so %@ recorded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not connected, so %2$@ recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未连接，所以改用 %2$@ 录音。"
          }
        }
      }
    },
    "%@ is not connected, so the system default input recorded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以改用系统默认输入录音。"
          }
        }
      }
    },
    "%lld of %lld words" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld words"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 %1$lld 个，最多 %2$lld 个"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于"
          }
        }
      }
    },
    "About once a day Orra asks GitHub for the latest version. Like any web request, the check carries your preferred languages, and nothing else about your Mac. Each update is installed only after you choose it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 大约每天向 GitHub 查询一次最新版本。和所有网页请求一样，查询会带上你偏好的语言，除此之外不发送任何关于你的 Mac 的信息。每次更新都要你同意后才会安装。"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加"
          }
        }
      }
    },
    "Add “%@” from the Clipboard to Vocabulary" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把拷贝的“%@”加入个人词库"
          }
        }
      }
    },
    "Added “%@” to Vocabulary" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已把“%@”加入个人词库"
