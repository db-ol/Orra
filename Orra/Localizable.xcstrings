    },
    "The cleanup model is not on this Mac yet. Until it is, Orra pastes the text without cleanup." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de limpieza todavía no está en esta Mac. Hasta que se descargue, Orra pega el texto sin limpiar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにはまだ整文モデルがありません。ダウンロードするまで、Orraは整文せずにテキストをペーストします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上还没有整理模型。下载好之前，Orra 会粘贴未经整理的文字。"
          }
        }
      }
    },
    "The download needs %@ of free space and %@ is free." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The download needs %1$@ of free space and %2$@ is free."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga necesita %1$@ de espacio disponible y solo hay %2$@ disponibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードには%1$@の空き容量が必要ですが、空き容量は%2$@しかありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载需要 %1$@ 的可用空间，目前可用 %2$@。"
          }
        }
      }
    },
