          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风需要权限"
          }
        }
      }
    },
    "The model comes from Hugging Face or a mirror. Your speech stays on this Mac." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo viene de Hugging Face o de una réplica. Tu voz no sale de esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはHugging Faceまたはミラーからダウンロードされます。音声がこのMacから送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型来自 Hugging Face 或其镜像。你的语音只留在这台 Mac 上。"
          }
        }
      }
    },
    "The model comes from Hugging Face or a mirror. Your text stays on this Mac." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo viene de Hugging Face o de una réplica. Tu texto no sale de esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはHugging Faceまたはミラーからダウンロードされます。テキストがこのMacから送信されることはありません。"
