    "Orra can use the microphone." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra puede usar el micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraはマイクを使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 可以使用麦克风。"
          }
        }
      }
    },
    "Orra changes your clipboard only when you choose Copy Report, or when your text is too long for the link." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra solo cambia tu portapapeles cuando eliges Copiar reporte o cuando tu texto es demasiado largo para el enlace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraがクリップボードを変更するのは、“レポートをコピー”を選んだときか、テキストが長すぎてリンクに収まらないときだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你选择“拷贝报告”，或者你的内容太长、链接放不下时，Orra 才会改动剪贴板。"
          }
        }
      }
    },
    "Orra could not add itself to Login Items" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo agregarse a Elementos de inicio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraをログイン項目に追加できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法将自己添加到登录项"
          }
        }
      }
    },
    "Orra could not capture the sound the Mac plays. Turn Live Captions off and on again to try again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo capturar el sonido que reproduce la Mac. Desactiva y vuelve a activar Subtítulos en vivo para intentarlo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrraはMacで再生中の音声を取り込めませんでした。もう一度試すには、“ライブキャプション”をオフにしてから再度オンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法捕获 Mac 播放的声音。请关闭“实时字幕”后再打开，重试一次。"
          }
        }
      }
    },
    "Orra could not download the model from Hugging Face or its mirrors." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo descargar el modelo de Hugging Face ni de sus réplicas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrraはHugging Faceまたはそのミラーからモデルをダウンロードできませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法从 Hugging Face 或其镜像下载模型。"
          }
        }
      }
    },
    "Orra could not listen to the voice sample. Record it again once the speech model is ready." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo escuchar la muestra de voz. Vuelve a grabarla cuando el modelo de transcripción esté listo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは音声サンプルを聞き取れませんでした。音声認識モデルの準備ができたら、もう一度録音してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法听取声音样本。请在语音模型就绪后重新录音。"
          }
        }
      }
    },
    "Orra could not play into %@." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo reproducir audio en %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは%@に音声を出力できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法向 %@ 播放。"
          }
        }
      }
    },
    "Orra could not read the voice sample saved on this Mac and deleted it. Record it again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo leer la muestra de voz guardada en esta Mac y la eliminó. Vuelve a grabarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacに保存された音声サンプルを読み込めなかったため、Orraはそれを削除しました。もう一度録音してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法读取保存在这台 Mac 上的声音样本，已将它删除。请重新录音。"
          }
        }
      }
    },
    "Orra could not read this audio file." : {
      "localizations" : {
        "es-419" : {
