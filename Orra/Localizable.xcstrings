            "value" : "重试"
          }
        }
      }
    },
    "Try it in any app: hold the talk key, say something, and let go. The text appears where you are typing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
