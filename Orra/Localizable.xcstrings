    "Everything you say is pasted in Chinese. Common English terms, such as PR or iPhone, may stay in English." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que dices se pega en chino. Los términos comunes en inglés, como PR o iPhone, pueden quedar en inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容はすべて中国語でペーストされます。PRやiPhoneなど、よく使われる英語の用語は英語のまま残ることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的内容都会以中文粘贴。PR、iPhone 这类常用英文词可能保留英文。"
          }
        }
      }
    },
    "Everything you say is pasted in English." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que dices se pega en inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容はすべて英語でペーストされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的内容都会以英文粘贴。"
          }
        }
      }
    },
    "Everything you say is pasted in Japanese. Common English terms, such as PR or iPhone, may stay in English." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que dices se pega en japonés. Los términos comunes en inglés, como PR o iPhone, pueden quedar en inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容はすべて日本語でペーストされます。PRやiPhoneなど、よく使われる英語の用語は英語のまま残ることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的内容都会以日文粘贴。PR、iPhone 这类常用英文词可能保留英文。"
          }
        }
      }
    },
    "Everything you say is pasted in Spanish. Common English terms, such as PR or iPhone, may stay in English." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que dices se pega en español. Los términos comunes en inglés, como PR o iPhone, pueden quedar en inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した内容はすべてスペイン語でペーストされます。PRやiPhoneなど、よく使われる英語の用語は英語のまま残ることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的内容都会以西班牙文粘贴。PR、iPhone 这类常用英文词可能保留英文。"
          }
        }
      }
    },
    "Find Orra in this list and turn on its switch." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca Orra en esta lista y activa su interruptor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストでOrraを探して、スイッチをオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这个列表里找到 Orra，打开它的开关。"
          }
        }
      }
    },
    "fn" : {
      "comment" : "A talk key inside a sentence",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la tecla fn"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球儀（fn）キー"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球仪（fn）键"
          }
        }
      }
    },
    "For a longer text, press the talk key twice quickly and talk hands free. Press it once more to paste." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un texto más largo, presiona rápido dos veces la tecla para hablar y habla en modo manos libres. Presiónala una vez más para pegar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長めのテキストは、音声入力キーをすばやく2回押すとハンズフリーで話せます。もう一度押すとペーストされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要说长一点的内容，可以快速连按两下说话键，松开后继续说。说完再按一下，文字就会粘贴进去。"
          }
        }
      }
    },
    "For meetings across languages. Read what others say in your language, and let them hear you in theirs, even in your own voice." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reuniones en varios idiomas. Lee en tu idioma lo que dicen los demás y deja que te escuchen en el suyo, incluso con tu propia voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の異なる会議のための機能です。相手の発言は自分の言語で読み、自分の発言は相手の言語で聞いてもらえます。自分の声で届けることもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跨语言开会时使用。对方说的话，你看到自己语言的字幕。你说自己的语言，对方听到的是他们的语言，还可以是你的音色。"
          }
        }
      }
    },
    "Forget Learned Corrections" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar correcciones aprendidas"
