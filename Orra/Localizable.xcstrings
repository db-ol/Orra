          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSでは、OptionキーだけやOptionキーとShiftキーだけのショートカットは使えません。ControlキーかCommandキーを加えるか、Optionキーを外してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 不接受只有 Option，或只有 Option 和 Shift 的快捷键。请加上 Control 或 Command，或者不用 Option。"
