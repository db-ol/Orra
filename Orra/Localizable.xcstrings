    },
    "This message is in a mailbox Projects does not read. Choose the mailbox in Settings first." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje está en un buzón que Proyectos no lee. Primero elige el buzón en Configuración."
          }
