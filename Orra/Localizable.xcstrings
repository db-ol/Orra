{
  "sourceLanguage" : "en",
  "strings" : {
    "(%@)" : {
      "comment" : "A talk key's label on other keyboards, such as (Alt)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（%@）"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A talk key with its label on other keyboards, such as ⌥ Right Option (Alt)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        }
      }
    },
    "%@ (lid closed)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已合盖）"
          }
        }
      }
    },
    "%@ (not connected)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（未连接）"
          }
        }
      }
    },
    "%@ could not start" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动"
          }
        }
      }
    },
    "%@ is a key combination and can't be the talk key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是组合键，不能作为说话键。"
          }
        }
      }
    },
    "%@ is a key combination and can't be the translation key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是组合键，不能作为翻译键。"
          }
        }
      }
    },
    "%@ is a shortcut of macOS or most apps and can't be the talk key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 macOS 或大多数 app 的快捷键，不能作为说话键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "%@ is a shortcut of macOS or most apps and can't be the translation key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 macOS 或大多数 app 的快捷键，不能作为翻译键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "%@ is chosen under Microphone. Choose another microphone or System Default there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“麦克风”中选择的是 %@。请在那里改选其他麦克风或“系统默认”。"
          }
        }
      }
    },
    "%@ is not connected, so %@ recorded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not connected, so %2$@ recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未连接，所以改用 %2$@ 录音。"
          }
        }
      }
    },
    "%@ is not connected, so the system default input recorded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以改用系统默认输入录音。"
          }
        }
      }
    },
    "%@ is not connected, so the translation was not spoken." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以没有说出译文。"
          }
        }
      }
    },
    "%lld seconds, in memory until Orra quits." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 秒，保存在内存中，直到 Orra 退出。"
          }
        }
      }
    },
    "%lld words" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个词"
          }
        }
      }
    },
    "%lld words. Orra gives the %lld most recently added or used to the speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld words. Orra gives the %2$lld most recently added or used to the speech model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %1$lld 个词。Orra 会把最近添加或用过的 %2$lld 个提供给语音模型。"
          }
        }
      }
    },
    "1 word" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 个词"
          }
        }
      }
    },
    "A key combination can't be the talk key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "组合键不能作为说话键。"
          }
        }
      }
    },
    "A key combination can't be the translation key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "组合键不能作为翻译键。"
          }
        }
      }
    },
    "A shortcut of macOS or most apps can't be the talk key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 或大多数 app 的快捷键不能作为说话键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "A shortcut of macOS or most apps can't be the translation key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 或大多数 app 的快捷键不能作为翻译键。否则 Orra 运行时它在哪里都不起作用。"
