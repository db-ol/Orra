    "Try Again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试"
          }
        }
      }
    },
    "Try it in any app: hold the talk key, say something, and let go. The text appears where you are typing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中试试：按住说话键，说点什么，然后松开。文字会出现在你正在输入的位置。"
          }
        }
      }
    },
    "Type a word or name, then press Return" : {
      "localizations" : {
        "zh-Hans" : {
