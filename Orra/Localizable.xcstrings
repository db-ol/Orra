    "Orra could not save the voice sample on this Mac." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pudo guardar la muestra de voz en esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは音声サンプルをこのMacに保存できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 无法在这台 Mac 上保存声音样本。"
          }
        }
      }
    },
    "Orra does not paste into password fields. Use Copy Last Dictation." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no pega en campos de contraseña. Usa Copiar último dictado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraはパスワードフィールドにはペーストしません。“最後の音声入力をコピー”を使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 不会粘贴到密码栏。请使用“拷贝上次听写”。"
          }
        }
      }
    },
    "Orra heard no speech in the voice sample." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra no oyó a nadie hablar en la muestra de voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは音声サンプルから話し声を聞き取れませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 在声音样本中没有听到语音。"
          }
        }
      }
    },
    "Orra is always in the menu bar. While this is off, it shows in the Dock only while one of its windows is open." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra siempre está en la barra de menús. Mientras esta opción esté desactivada, aparece en el Dock solo cuando una de sus ventanas está abierta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは常にメニューバーにあります。この設定がオフの場合、DockにはOrraのウインドウが開いているときだけ表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 始终在菜单栏中。关闭此项后，只有在 Orra 的窗口打开时，程序坞里才会显示它。"
          }
        }
      }
    },
    "Orra is ready" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes usar Orra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraの準備ができました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 已准备就绪"
          }
        }
      }
    },
    "Orra is recording a voice sample in Settings" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra está grabando una muestra de voz en Configuración"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは設定で音声サンプルを録音中です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 正在设置中录制声音样本"
          }
        }
      }
    },
    "Orra is still stopping the last recording." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra todavía está terminando la grabación anterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraは前回の録音を停止しているところです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 正在结束上一次录音。"
          }
        }
      }
    },
    "Orra keeps the last %lld sentences." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra solo conserva las últimas %lld oraciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが保持するのは直近の%lld文だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 只保留最近 %lld 句。"
          }
        }
      }
    },
    "Orra needs it to notice the talk key and to paste the text. Turn on Orra in the list that opens, then come back here." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra necesita este acceso para detectar la tecla para hablar y pegar el texto. Activa Orra en la lista que se abre y luego vuelve aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが音声入力キーを検知してテキストをペーストするために必要です。開いたリストでOrraをオンにしてから、ここに戻ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 需要它来识别说话键并粘贴文字。请在打开的列表中打开 Orra，然后回到这里。"
          }
        }
      }
    },
    "Orra needs its speech model to transcribe." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra necesita su modelo de transcripción para convertir la voz en texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが文字起こしをするには、音声認識モデルが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 需要语音模型才能转写。"
          }
        }
      }
    },
    "Orra needs microphone access to record. Setup Guide in the Orra menu can turn it on." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra necesita acceso al micrófono para grabar. Puedes activarlo desde Guía de configuración, en el menú de Orra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音するには、Orraにマイクへのアクセスが必要です。Orraメニューの“セットアップガイド”でオンにできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 需要麦克风权限才能录音。可以在 Orra 菜单的“设置向导”中打开。"
          }
        }
      }
    },
    "Orra never learns corrections from a translated paste." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra nunca aprende correcciones de un texto que pegó traducido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳してペーストしたテキストから、Orraが修正を学習することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 不会从翻译后粘贴的文字中学习更正。"
          }
        }
      }
    },
    "Orra never speaks into the speakers on its own. Without Orra Microphone, pick a device here, such as a loopback device a meeting app can use as its microphone." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra nunca habla a través de las bocinas por su cuenta. Sin Orra Microphone, elige aquí un dispositivo, como un dispositivo de loopback que una app de reuniones pueda usar como micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが自動でスピーカーから読み上げることはありません。Orra Microphoneがない場合は、会議アプリがマイクとして使えるループバックデバイスなど、ここでデバイスを選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 不会自行通过扬声器说话。没有 Orra Microphone 时，请在这里选择一个设备，例如会议应用可以用作麦克风的环回设备。"
          }
        }
      }
    },
    "Orra opens the folder with the report file. Drag the file into the page on GitHub." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra abre la carpeta con el archivo del reporte. Arrastra el archivo a la página de GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraがレポートファイルのあるフォルダを開きます。そのファイルをGitHubのページにドラッグしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 会打开报告文件所在的文件夹，请把文件拖进 GitHub 页面。"
          }
        }
      }
    },
    "Orra records only after you press the talk key, until you press it again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra solo graba desde que presionas la tecla para hablar hasta que la vuelves a presionar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが録音するのは、音声入力キーを押してから、もう一度押すまでの間だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 只在你按下说话键后录音，再按一下就停止。"
          }
        }
      }
    },
    "Orra records only while you hold the talk key." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra solo graba mientras mantienes presionada la tecla para hablar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが録音するのは、音声入力キーを押している間だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 只在你按住说话键时录音。"
          }
        }
      }
    },
    "Orra records up to %lld minutes at a time, so the recording stopped there." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra graba hasta %lld minutos cada vez, así que la grabación se detuvo en ese punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orraが一度に録音できるのは最大%lld分のため、その時点で録音を停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 每次最多录 %lld 分钟，所以录音到这里就停止了。"
          }
        }
      }
    },
    "Orra Settings" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuración de Orra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra設定"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 设置"
