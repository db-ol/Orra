            "value" : "这次听写会被翻译。"
          }
        }
      }
    },
    "This key can't be the talk key. Holding it would type or do something in the app in front." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个键不能作为说话键。按住它会输入文字或在前台 App 中执行操作。"
          }
        }
      }
    },
    "This key can't be the translation key. Holding it would type or do something in the app in front." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个键不能作为翻译键。按住它会输入文字或在前台 App 中执行操作。"
          }
        }
      }
    },
    "This Mac is offline. Connect to the internet, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
