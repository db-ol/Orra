    "Read Mailbox Names from Mail" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer nombres de buzones de Mail"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“メール”からメールボックス名を読み取る"
          }
