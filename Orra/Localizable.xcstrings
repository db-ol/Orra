        }
      }
    },
    "Projects explains mail and drafts replies with the cleanup model. The model comes from Hugging Face or a mirror. Your mail and files stay on this Mac." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectos explica el correo y redacta respuestas con el modelo de limpieza. El modelo viene de Hugging Face o de una réplica. Tu correo y tus archivos no salen de esta Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト”は、整文モデルでメールを説明し、返信の下書きを作成します。モデルはHugging Faceまたはミラーからダウンロードされます。メールとファイルがこのMacから送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“项目”使用整理模型解释邮件并起草回复。模型来自 Hugging Face 或其镜像。你的邮件和文件只留在这台 Mac 上。"
          }
        }
      }
    },
    "Projects found no text in it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectos no encontró texto en él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト”はこのファイルにテキストを見つけられませんでした。"
