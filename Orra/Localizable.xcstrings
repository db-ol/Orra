    },
    "Live Captions and Speak Translations to Others are under Meeting Interpretation, in Settings and in the Orra menu. Speaking translations needs Translation on." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtítulos en vivo y Leer traducciones a los demás están en Interpretación en reuniones, en Configuración y en el menú de Orra. Para leer las traducciones en voz alta, Traducción debe estar activada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ライブキャプション”と“翻訳を相手に読み上げる”は、設定とOrraメニューの“会議通訳”にあります。翻訳を読み上げるには“翻訳”をオンにする必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时字幕和为对方朗读译文都在“会议同传”里，设置和 Orra 菜单中都有。朗读译文需要先打开翻译。"
          }
        }
      }
    },
    "Live captions are off each time Orra starts. Closing the caption window turns them off." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos en vivo están desactivados cada vez que se abre Orra. Si cierras la ventana de subtítulos, se desactivan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブキャプションは、Orraを起動するたびにオフになります。キャプションウインドウを閉じてもオフになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次启动 Orra 时，实时字幕都是关闭的。关闭字幕窗口也会关闭实时字幕。"
          }
        }
      }
    },
