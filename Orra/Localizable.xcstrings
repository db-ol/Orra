    "The %@ key can't be the talk key. Holding it would type or do something in the app in front." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecla %@ no puede ser la tecla para hablar. Mantenerla presionada escribiría texto o haría algo en la app que está al frente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@キーは音声入力キーにできません。押したままにすると、最前面のアプリで文字が入力されたり、何かが実行されたりします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”键不能作为说话键。按住它会输入文字或在前台 App 中执行操作。"
          }
        }
      }
    },
    "The %@ key can't be the translation key. Holding it would type or do something in the app in front." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecla %@ no puede ser la tecla de traducción. Mantenerla presionada escribiría texto o haría algo en la app que está al frente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@キーは翻訳キーにできません。押したままにすると、最前面のアプリで文字が入力されたり、何かが実行されたりします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”键不能作为翻译键。按住它会输入文字或在前台 App 中执行操作。"
          }
        }
      }
    },
    "The cleanup model could not be loaded" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el modelo de limpieza"
