    },
    "%lld words. Orra gives the %lld most recently added or used to the speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld words. Orra gives the %2$lld most recently added or used to the speech model."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld palabras. Orra le da al modelo de transcripción las %2$lld agregadas o usadas más recientemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全%1$lld語。Orraは、最近追加または使用した順に%2$lld語を音声認識モデルに渡します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %1$lld 个词。Orra 会把最近添加或用过的 %2$lld 个提供给语音模型。"
          }
        }
      }
    },
