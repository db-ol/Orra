        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法载入本地模型"
          }
        }
      }
    },
    "The local model is not on this Mac yet. Until it is, captions show what was said without translation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上还没有本地模型。下载好之前，字幕只显示原话，不翻译。"
          }
        }
      }
    },
    "The local model is not on this Mac yet. Until it is, Orra pastes the text without translation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上还没有本地模型。下载好之前，Orra 会粘贴未翻译的文字。"
          }
        }
      }
    },
    "The local model is not ready, so the text was pasted without translation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地模型还没准备好，所以粘贴的是未翻译的文字。"
