    "Recommended: fn on a Mac's built in keyboard, right Control on an external keyboard." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomendado: la tecla fn en el teclado integrado de una Mac y la tecla Control derecha en un teclado externo."
          }
        },
        "ja" : {
          "stringUnit" : {
