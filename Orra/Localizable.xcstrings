    "Shift can't be the talk key. On its own, it switches input methods between Chinese and English." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecla Mayúsculas no puede ser la tecla para hablar. Por sí sola, cambia la fuente de entrada entre chino e inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiftキーは音声入力キーにできません。単独で押すと、中国語と英語の入力ソースが切り替わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift 键不能作为说话键。单独按下它会切换中英文输入法。"
          }
        }
      }
    },
    "Shift can't be the translation key. On its own, it switches input methods between Chinese and English." : {
