    "Speaks in the language the translation key translates into (Translate into, on the Translation page)." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee en el idioma al que traduce la tecla de traducción (Traducir a, en la página Traducción)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
