    "The microphone changed during the recording. Try again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono cambió durante la grabación. Vuelve a intentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音中にマイクが変わりました。もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音时麦克风发生了变化。请再试一次。"
          }
        }
      }
    },
    "The microphone could not start" : {
      "localizations" : {
        "es-419" : {
