          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 秒，保存在这台 Mac 上。"
          }
        }
      }
    },
    "%lld words" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld palabras"
          }
        },
