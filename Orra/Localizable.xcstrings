    },
    "Record a Voice Sample" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar una muestra de voz"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サンプルを録音"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制声音样本"
          }
        }
      }
    },
    "Record your own voice only. Orra writes down what you said with its speech model and keeps the recording and the words in memory until it quits. The other side hears a synthesized voice, so let them know." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba solo tu propia voz. Orra convierte en texto lo que dijiste con su modelo de transcripción y guarda la grabación y las palabras en la memoria hasta que se cierre. La otra parte escucha una voz sintetizada, así que avísale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の声だけを録音してください。Orraは話した内容を音声認識モデルで書き起こします。録音とテキストは、Orraが終了するまでメモリに保持されます。相手には合成音声が聞こえるので、そのことを伝えておいてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只录你自己的声音。Orra 会用语音模型写下你说的话，录音和文字只保存在内存中，直到退出。对方听到的是合成的声音，请告诉他们。"
          }
        }
      }
    },
    "Record your own voice only. Orra writes down what you said with its speech model and keeps the words in memory until it quits. With Remember my voice on, it saves the recording on this Mac until you remove it. The other side hears a synthesized voice, so let them know." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba solo tu propia voz. Orra convierte en texto lo que dijiste con su modelo de transcripción y guarda las palabras en la memoria hasta que se cierre. Con Recordar mi voz activado, guarda la grabación en esta Mac hasta que la elimines. La otra parte escucha una voz sintetizada, así que avísale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の声だけを録音してください。Orraは話した内容を音声認識モデルで書き起こします。テキストは、Orraが終了するまでメモリに保持されます。“自分の声を記憶”をオンにすると、録音は削除するまでこのMacに保存されます。相手には合成音声が聞こえるので、そのことを伝えておいてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只录你自己的声音。Orra 会用语音模型写下你说的话，文字只保存在内存中，直到退出。打开“记住我的音色”后，录音会保存在这台 Mac 上，直到你移除。对方听到的是合成的声音，请告诉他们。"
          }
        }
      }
    },
    "Record…" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音…"
          }
        }
      }
    },
    "Recording stopped after %lld seconds. Play it back to check it, then use it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo después de %lld segundos. Reprodúcela para revisarla y luego úsala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld秒で録音が停止しました。再生して確認してから使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音满 %lld 秒，已自动停止。可以先回放检查，再使用。"
          }
        }
      }
    },
    "Recording. Click Stop when you have read it all. Recording stops by itself after %lld seconds." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabando. Haz clic en Detener cuando lo hayas leído todo. La grabación se detiene sola después de %lld segundos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音中です。すべて読み終えたら“停止”をクリックしてください。録音は%lld秒で自動的に停止します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在录音。读完后点按“停止”。录音满 %lld 秒会自动停止。"
          }
        }
      }
    },
    "Remember my voice" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar mi voz"
          }
        },
        "ja" : {
