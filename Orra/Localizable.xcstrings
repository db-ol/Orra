    "What it says" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué dice"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールの要点"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
