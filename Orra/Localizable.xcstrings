    },
    "Speak Translations to Others" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer traducciones a los demás"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳を相手に読み上げる"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为对方朗读译文"
          }
        }
      }
    },
    "Speech is turned into text on this Mac, and so is the optional cleanup. Orra goes online only to download the speech model or the cleanup model when you ask it to, and to check for updates when you allow it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz se convierte en texto en esta Mac, y la limpieza opcional también se hace en ella. Orra solo se conecta a Internet para descargar el modelo de transcripción o el modelo de limpieza cuando se lo pides, y para buscar actualizaciones cuando lo permites."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこのMac上でテキストに変換され、オプションの整文もこのMac上で行われます。Orraがインターネットに接続するのは、指示に応じて音声認識モデルや整文モデルをダウンロードするときと、許可した場合にアップデートを確認するときだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音在这台 Mac 上转成文字，可选的整理也在这台 Mac 上完成。Orra 只在两种情况下联网：你要求下载语音模型或整理模型时，以及你允许后检查更新时。"
          }
        }
      }
    },
    "Speech model" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo de transcripción"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識モデル"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音模型"
          }
        }
      }
    },
    "Still downloading. It goes on if you close this window." : {
      "localizations" : {
        "es-419" : {
