{
  "sourceLanguage" : "en",
  "strings" : {
    "(%@)" : {
      "comment" : "A talk key's label on other keyboards, such as (Alt)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（%@）"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A talk key with its label on other keyboards, such as ⌥ Right Option (Alt)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        }
      }
    },
    "%@ (lid closed)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已合盖）"
          }
        }
      }
    },
    "%@ (not connected)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（未连接）"
          }
        }
      }
    },
    "%@ could not start" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动"
          }
        }
      }
    },
    "%@ is a key combination and can't be the talk key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是组合键，不能作为说话键。"
          }
        }
      }
    },
    "%@ is chosen under Microphone. Choose another microphone or System Default there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“麦克风”中选择的是 %@。请在那里改选其他麦克风或“系统默认”。"
          }
        }
      }
    },
    "%@ is not connected, so %@ recorded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not connected, so %2$@ recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未连接，所以改用 %2$@ 录音。"
          }
        }
      }
    },
    "%@ is not connected, so the system default input recorded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以改用系统默认输入录音。"
          }
        }
      }
    },
    "%lld words" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个词"
          }
        }
      }
    },
    "%lld words. Orra gives the %lld most recently added or used to the speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld words. Orra gives the %2$lld most recently added or used to the speech model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %1$lld 个词。Orra 会把最近添加或用过的 %2$lld 个提供给语音模型。"
          }
        }
      }
    },
    "1 word" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 个词"
          }
        }
      }
    },
    "A key combination can't be the talk key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "组合键不能作为说话键。"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于"
          }
        }
      }
    },
    "About once a day Orra asks GitHub for the latest version. Like any web request, the check carries your preferred languages, and nothing else about your Mac. Each update is installed only after you choose it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orra 大约每天向 GitHub 查询一次最新版本。和所有网页请求一样，查询会带上你偏好的语言，除此之外不发送任何关于你的 Mac 的信息。每次更新都要你同意后才会安装。"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加"
          }
        }
      }
    },
    "Add “%@” from the Clipboard to Vocabulary" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把拷贝的“%@”加入个人词库"
          }
        }
      }
    },
    "Add a word to your vocabulary?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
