          }
        }
      }
    },
    "Speaks to an assistant" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le habla a un asistente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントに向けた文"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对助手说话"
          }
        }
      }
    },
    "Speech is turned into text on this Mac, and so is the optional cleanup. Orra goes online only to download the models you ask for, and to check for updates when you allow it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz se convierte en texto en esta Mac, y la limpieza opcional también se hace en ella. Orra solo se conecta a Internet para descargar los modelos que pides, y para buscar actualizaciones cuando lo permites."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこのMac上でテキストに変換され、オプションの整文もこのMac上で行われます。Orraがインターネットに接続するのは、指示に応じてモデルをダウンロードするときと、許可した場合にアップデートを確認するときだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音在这台 Mac 上转成文字，可选的整理也在这台 Mac 上完成。Orra 只在两种情况下联网：下载你要求的模型时，以及你允许后检查更新时。"
          }
        }
      }
    },
