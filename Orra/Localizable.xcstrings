        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージは“プロジェクト”が読み取らないメールボックスにあります。先に設定でそのメールボックスを選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
