    },
    "%@. Chinese becomes English, and English becomes Chinese." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El chino pasa a inglés y el inglés, a chino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。中国語は英語に、英語は中国語になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。中文变成英文，英文变成中文。"
          }
        }
      }
    },
    "%@. Japanese becomes English, and English becomes Japanese." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El japonés pasa a inglés y el inglés, a japonés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。日本語は英語に、英語は日本語になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。日文变成英文，英文变成日文。"
          }
        }
      }
    },
    "%@. Spanish becomes English, and English becomes Spanish." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El español pasa a inglés y el inglés, a español."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。スペイン語は英語に、英語はスペイン語になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。西班牙文变成英文，英文变成西班牙文。"
          }
        }
      }
    },
    "%lld seconds, in memory until Orra quits." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld segundos, en la memoria hasta que Orra se cierre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld秒、Orraが終了するまでメモリに保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 秒，保存在内存中，直到 Orra 退出。"
          }
        }
      }
    },
    "%lld seconds, saved on this Mac." : {
      "localizations" : {
        "es-419" : {
