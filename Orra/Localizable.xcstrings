            "state" : "translated",
            "value" : "按住"
          }
        }
      }
    },
    "Hold %@ to talk" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada %@ para hablar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を押したまま話す"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住%@说话"
