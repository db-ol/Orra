    "Projects cannot find this email in Mail now, so the draft is only on the clipboard. Reply to it in Mail and press ⌘V." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectos no encuentra este correo en Mail ahora, así que el borrador solo está en el portapapeles. Respóndelo en Mail y presiona ⌘V."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト”は今“メール”内でこのメールを見つけられないため、下書きはクリップボードにコピーしただけです。“メール”でこのメールに返信し、⌘Vを押してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“项目”现在无法在“邮件”中找到这封邮件，所以草稿只放到了剪贴板上。请在“邮件”中回复这封邮件，然后按下 ⌘V。"
          }
        }
      }
