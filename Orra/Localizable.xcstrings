    "%@ could not start" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo iniciarse"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を起動できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动"
          }
        }
      }
    },
    "%@ is a key combination and can't be the talk key." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una combinación de teclas y no puede ser la tecla para hablar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はキーの組み合わせのため、音声入力キーにできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是组合键，不能作为说话键。"
          }
        }
      }
    },
    "%@ is a key combination and can't be the translation key." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una combinación de teclas y no puede ser la tecla de traducción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はキーの組み合わせのため、翻訳キーにできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是组合键，不能作为翻译键。"
          }
        }
      }
    },
    "%@ is a shortcut of macOS or most apps and can't be the Live Captions shortcut. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una función rápida de teclado de macOS o de la mayoría de las apps y no puede ser la función rápida de teclado para Subtítulos en vivo. Dejaría de funcionar en todas partes mientras Orra esté en ejecución."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はmacOSや多くのアプリのショートカットのため、ライブキャプションのショートカットにできません。設定すると、Orraの実行中はどこでもそのショートカットが使えなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 macOS 或大多数 app 的快捷键，不能作为实时字幕快捷键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "%@ is a shortcut of macOS or most apps and can't be the talk key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una función rápida de teclado de macOS o de la mayoría de las apps y no puede ser la tecla para hablar. Dejaría de funcionar en todas partes mientras Orra esté en ejecución."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はmacOSや多くのアプリのショートカットのため、音声入力キーにできません。設定すると、Orraの実行中はどこでもそのショートカットが使えなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 macOS 或大多数 app 的快捷键，不能作为说话键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "%@ is a shortcut of macOS or most apps and can't be the translation key. It would stop working everywhere while Orra runs." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una función rápida de teclado de macOS o de la mayoría de las apps y no puede ser la tecla de traducción. Dejaría de funcionar en todas partes mientras Orra esté en ejecución."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はmacOSや多くのアプリのショートカットのため、翻訳キーにできません。設定すると、Orraの実行中はどこでもそのショートカットが使えなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 macOS 或大多数 app 的快捷键，不能作为翻译键。否则 Orra 运行时它在哪里都不起作用。"
          }
        }
      }
    },
    "%@ is already one of Orra's keys." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya es una de las teclas de Orra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでにOrraのキーとして使われています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已经是 Orra 的按键了。"
          }
        }
      }
    },
    "%@ is chosen under Microphone. Choose another microphone or System Default there." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está seleccionado en Micrófono. Cámbialo por otro micrófono o por Predeterminado del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“マイク”で%@が選択されています。ほかのマイクか“システムのデフォルト”に変更してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“麦克风”中选择的是 %@。请在那里改选其他麦克风或“系统默认”。"
          }
        }
      }
    },
    "%@ is not connected, so %@ recorded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not connected, so %2$@ recorded."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no está conectado, así que se grabó con %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が接続されていないため、%2$@で録音しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未连接，所以改用 %2$@ 录音。"
          }
        }
      }
    },
    "%@ is not connected, so the system default input recorded." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectado, así que se grabó con la entrada predeterminada del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が接続されていないため、システムのデフォルトの入力で録音しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以改用系统默认输入录音。"
          }
        }
      }
    },
    "%@ is not connected, so the translation was not spoken." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectado, así que la traducción no se leyó en voz alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が接続されていないため、訳文を読み上げませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接，所以没有说出译文。"
          }
