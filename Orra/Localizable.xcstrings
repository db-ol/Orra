    "No sound from the Mac yet. If something is playing, allow Orra under Screen & System Audio Recording in Privacy & Security settings." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no se recibe sonido de la Mac. Si algo se está reproduciendo, activa Orra en Grabación de audio del sistema y pantalla, en la configuración de Privacidad y seguridad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macからの音声がまだ届いていません。何かを再生中の場合は、“プライバシーとセキュリティ”設定の“画面収録とシステムオーディオ録音”でOrraを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有收到 Mac 播放的声音。如果正在播放，请在“隐私与安全性”设置的“录屏与系统录音”中允许 Orra。"
          }
        }
