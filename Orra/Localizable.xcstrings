        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“项目”没有在其中找到文字。"
          }
        }
      }
    },
    "Projects has not read this message. It reads the mail of the last %lld days in the mailboxes you chose." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectos no leyó este mensaje. Lee el correo de los últimos %lld días en los buzones que elegiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト”はこのメッセージを読み取っていません。選んだメールボックスの過去%lld日間のメールを読み取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
