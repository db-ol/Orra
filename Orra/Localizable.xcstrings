    },
    "The microphone is busy. Try again in a moment." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono está ocupado. Vuelve a intentarlo en un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
