        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存报告。"
          }
        }
      }
    },
    "The report could not be saved. Try again, or turn off Attach the diagnostic report to go on without it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el reporte. Vuelve a intentarlo o desactiva Adjuntar el reporte de diagnóstico para continuar sin él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートを保存できませんでした。もう一度試すか、“診断レポートを添付”をオフにしてレポートなしで続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存报告。请再试一次，或关闭“附上诊断报告”，不附报告继续。"
          }
        }
      }
    },
    "The rules run on every dictation, with or without the local model, and before it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas se aplican a cada dictado antes del modelo local, lo uses o no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのルールは、ローカルモデルを使うかどうかにかかわらず、すべての音声入力にモデルより先に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次听写都会应用这些规则，不论是否打开本地模型，而且在模型之前。"
          }
        }
      }
    },
