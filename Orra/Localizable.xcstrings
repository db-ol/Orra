    "All set! Hold the talk key and say hello." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Todo listo! Mantén presionada la tecla para hablar y saluda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができました。音声入力キーを押したまま、“こんにちは”と話してみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好了！按住说话键，打个招呼吧。"
          }
        }
      }
    },
    "All set! Press the talk key and say hello." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Todo listo! Presiona la tecla para hablar y saluda."
          }
