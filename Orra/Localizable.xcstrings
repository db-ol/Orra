    "Add “%@” from the Clipboard to Vocabulary" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar “%@” del portapapeles al Vocabulario"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの“%@”を用語集に追加"
          }
