            "value" : "记住我的音色"
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除"
          }
        }
      }
    },
    "Remove %lld Words" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar %lld palabras"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld語を削除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %lld 个词"
          }
        }
      }
    },
    "Remove filler words such as um and uh" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar muletillas como “um” y “uh”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“um”や“uh”などのフィラーを削除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉“呃”“嗯”这类语气词"
          }
        }
      }
    },
    "Removes fillers and applies spoken self corrections, such as “三点，哦不对，四点”. It needs a %@ download and about 4 GB of memory, adds under a second to a short dictation and more to a long one, and runs on this Mac. Paste Original Text in the Orra menu brings back the text from before the cleanup." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las muletillas y aplica las rectificaciones que haces al hablar, como “三点，哦不对，四点”. Necesita una descarga de %@ y unos 4 GB de memoria, agrega menos de un segundo a un dictado corto y más a uno largo, y se ejecuta en esta Mac. Pegar texto original, en el menú de Orra, recupera el texto de antes de la limpieza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィラーを削除し、“三点，哦不对，四点”のような話しながらの言い直しを反映します。%@のダウンロードと約4 GBのメモリが必要です。処理時間は、短い音声入力で1秒未満、長い音声入力ではそれ以上増えます。処理はすべてこのMac上で行われます。Orraメニューの“原文をペースト”で整文前のテキストを戻せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉语气词，并按你说出口的更正改好内容，比如“三点，哦不对，四点”。需要下载 %@，约占 4 GB 内存，短的听写多花不到 1 秒，长的更久，全部在这台 Mac 上运行。Orra 菜单中的“粘贴原文”可以找回整理之前的文字。"
          }
        }
      }
    },
    "Removes fillers and fixes what you correct while speaking." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las muletillas y aplica las rectificaciones que haces al hablar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィラーを削除し、話しながらの言い直しを反映します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说完自动去掉语气词，并按你的改口改好。"
          }
        }
      }
    },
    "Removes um, uh and erm where they only fill a pause, and the same sounds in Chinese. Words that carry meaning stay as you said them." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina “um”, “uh” y “erm” cuando solo rellenan una pausa, y los mismos sonidos en chino. Las palabras con significado se quedan como las dijiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間をつなぐだけのum、uh、ermと、中国語の同様の音を削除します。意味のある言葉は話したとおりに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉只用来停顿的“呃”“额”“嗯”“啊”“哦”，英文里的同类词也会去掉。有意义的词，比如“好啊”“吧”“那个”，以及“嗯，好的”这样的回答，会照原样保留。"
          }
        }
      }
    },
    "Report a Problem" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportar un problema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題を報告"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
