    "Open Microphone Settings…" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir configuración de Micrófono…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
