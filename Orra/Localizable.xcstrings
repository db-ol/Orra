          }
        }
      }
    },
    "This project holds more files than Projects reads. The others are left out." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto tiene más archivos de los que lee Proyectos. Los demás quedan fuera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトには“プロジェクト”が読み取れる数を超えるファイルがあります。それ以外のファイルは除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个项目的文件数超过了“项目”读取的上限，其余文件会被略去。"
          }
        }
      }
    },
    "This removes the project with its index, mail and drafts from Projects. Your mail in Mail and the files in its folders stay as they are." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará el proyecto de Proyectos con su índice, su correo y sus borradores. Tu correo en Mail y los archivos de sus carpetas no cambian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトと、そのインデックス、メール、下書きを“プロジェクト”から削除します。“メール”内のメールとフォルダ内のファイルはそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从“项目”中移除这个项目，以及它的索引、邮件和草稿。“邮件” App 里的邮件和它文件夹里的文件保持不变。"
          }
        }
      }
    },
